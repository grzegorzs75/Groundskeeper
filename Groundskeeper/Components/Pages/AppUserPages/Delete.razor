@page "/appusers/delete"
@using Microsoft.EntityFrameworkCore
@using Groundskeeper.Models
@inject IDbContextFactory<Groundskeeper.Data.GroundskeeperDbContext> DbFactory
@inject NavigationManager NavigationManager

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>AppUser</h2>
    <hr />
    @if (appuser is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@appuser.Name</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Email</dt>
            <dd class="col-sm-10">@appuser.Email</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">PasswordHash</dt>
            <dd class="col-sm-10">@appuser.PasswordHash</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">UserGroup</dt>
            <dd class="col-sm-10">@appuser.UserGroup</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">CustomerId</dt>
            <dd class="col-sm-10">@appuser.CustomerId</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Customer</dt>
            <dd class="col-sm-10">@appuser.Customer</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Active</dt>
            <dd class="col-sm-10">@appuser.Active</dd>
        </dl>
        <EditForm method="post" Model="appuser" OnValidSubmit="DeleteAppUser" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(appuser is null)">Delete</button> |
            <a href="/appusers">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private AppUser? appuser;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        appuser = await context.AppUsers.FirstOrDefaultAsync(m => m.Id == Id);

        if (appuser is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteAppUser()
    {
        using var context = DbFactory.CreateDbContext();
        context.AppUsers.Remove(appuser!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/appusers");
    }
}
