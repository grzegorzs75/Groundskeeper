@page "/assets/delete"
@using Microsoft.EntityFrameworkCore
@using Groundskeeper.Models
@inject IDbContextFactory<Groundskeeper.Data.GroundskeeperDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Asset</h2>
    <hr />
    @if (asset is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@asset.Name</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Description</dt>
            <dd class="col-sm-10">@asset.Description</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">SiteId</dt>
            <dd class="col-sm-10">@asset.SiteId</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Site</dt>
            <dd class="col-sm-10">@asset.Site</dd>
        </dl>
        <EditForm method="post" Model="asset" OnValidSubmit="DeleteAsset" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(asset is null)">Delete</button> |
            <a href="/assets">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Asset? asset;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        asset = await context.Assets.FirstOrDefaultAsync(m => m.Id == Id);

        if (asset is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteAsset()
    {
        using var context = DbFactory.CreateDbContext();
        context.Assets.Remove(asset!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/assets");
    }
}
