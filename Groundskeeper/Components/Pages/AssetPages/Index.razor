@page "/assets"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Groundskeeper.Models
@using Groundskeeper.Data
@implements IAsyncDisposable
@inject IDbContextFactory<Groundskeeper.Data.GroundskeeperDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Index</PageTitle>

<h1>Index</h1>

<p>
    <a href="assets/create">Create New</a>
</p>

<QuickGrid Class="table" Items="Assets.AsQueryable()">
    <PropertyColumn Property="asset => asset.Name" />
    <PropertyColumn Property="asset => asset.Description" />
    <PropertyColumn Property="asset => asset.SiteId" />
    <PropertyColumn Property="asset => asset.Site.Name" />

    <TemplateColumn Context="asset">
        <a href="@($"assets/edit?id={asset.Id}")">Edit</a> |
        <a href="@($"assets/details?id={asset.Id}")">Details</a> |
        <a href="@($"assets/delete?id={asset.Id}")">Delete</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private GroundskeeperDbContext context = default!;

    List<Asset> Assets = [];

    protected override async Task OnInitializedAsync()
    {
        context = DbFactory.CreateDbContext();

        Assets = await context.Assets
            .Include(s => s.Site)
            .ToListAsync();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
