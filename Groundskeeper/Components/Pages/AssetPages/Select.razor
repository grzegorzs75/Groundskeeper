@page "/assets/select"
@using Microsoft.EntityFrameworkCore
@using Groundskeeper.Models
@inject IDbContextFactory<Groundskeeper.Data.GroundskeeperDbContext> DbFactory
@inject NavigationManager NavigationManager

@inject Groundskeeper.Services.WorkContext WorkContext

<PageTitle>Wybierz</PageTitle>

<h1>Wybierz</h1>

<p>Czy chcesz ustawić to boisko jako bieżące?</p>
<div>
    <h2>Boisko</h2>
    <hr />
    @if (asset is null)
    {
        <p><em>Pobieranie...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Nazwa boiska</dt>
            <dd class="col-sm-10">@asset.Name</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Opis</dt>
            <dd class="col-sm-10">@asset.Description</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Obiekt</dt>
            <dd class="col-sm-10">@asset.SiteId</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Nazwa obiektu</dt>
            <dd class="col-sm-10">@asset.Site.Name</dd>
        </dl>
        <EditForm method="post" Model="asset" OnValidSubmit="SelectAsset" FormName="select" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(asset is null)">Wybierz</button> |
            <a href="/assets">Powrót do listy</a>
        </EditForm>
    }
</div>

@code {
    private Asset? asset;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        asset = await context.Assets
        .Include(s => s.Site)
        .FirstOrDefaultAsync(m => m.Id == Id);

        if (asset is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task SelectAsset()
    {
        using var context = DbFactory.CreateDbContext();
        WorkContext.AssetId = asset.Id;

        NavigationManager.NavigateTo("/assets");
    }
}
