@page "/customers"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Groundskeeper.Models
@using Groundskeeper.Data
@implements IAsyncDisposable
@inject IDbContextFactory<Groundskeeper.Data.GroundskeeperDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Kartoteka klientów</PageTitle>

<h1>Kartoteka klientów</h1>

<p>
    <a href="customers/create">Nowy klient</a>
</p>

<QuickGrid Class="table" Items="context.Customers">
    <PropertyColumn Property="customer => customer.Name" Title="Nazwa klienta" />
    <!--
        <PropertyColumn Property="customer => customer.ContactName" />
    <PropertyColumn Property="customer => customer.Email" />
    <PropertyColumn Property="customer => customer.Phone" />
    <PropertyColumn Property="customer => customer.Notes" />
    -->

    <TemplateColumn Context="customer">
        <a href="@($"customers/edit?id={customer.Id}")">Zmień</a> |
        <!--
        <a href="@($"customers/details?id={customer.Id}")">Details</a> |
        -->
        <a href="@($"customers/delete?id={customer.Id}")">Usuń</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private GroundskeeperDbContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
