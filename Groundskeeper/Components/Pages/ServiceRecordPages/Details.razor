@page "/servicerecords/details"
@using Microsoft.EntityFrameworkCore
@using Groundskeeper.Models
@using Groundskeeper.Services
@inject IDbContextFactory<Groundskeeper.Data.GroundskeeperDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject IWebHostEnvironment Environment
@inject IImageService ImageService

<PageTitle>Szczegóły zabiegu</PageTitle>

<h1>Szczegóły zabiegu</h1>

<div>
    <h2>Zabieg</h2>
    <hr />
    @if (servicerecord is null)
    {
        <p><em>Pobieranie...</em></p>
    }
    else {
        <dl class="row">
            
            <dt class="col-sm-2">Boisko</dt>
            <dd class="col-sm-10">@($"{servicerecord.Asset.Site.Customer.Name}\\{servicerecord.Asset.Site.Name}\\{servicerecord.Asset.Name}")</dd>
            <dt class="col-sm-2">Data</dt>
            <dd class="col-sm-10">@servicerecord.ServiceDate.ToString("d")</dd>
            <dt class="col-sm-2">Nazwa</dt>
            <dd class="col-sm-10">@servicerecord.Title</dd>
            <dt class="col-sm-2">Opis wewnętrzny</dt>
            <dd class="col-sm-10">@servicerecord.Description</dd>
            <dt class="col-sm-2">Opis zewnętrzny</dt>
            <dd class="col-sm-10">@servicerecord.Notes</dd>
        </dl>

        <h4>Zdjęcia</h4>

        <div class="mb-3">
            <InputFile OnChange="UploadPhoto" accept="image/*" />
        </div>

        @if (servicerecord.Photos.Any())
        {
            <div class="row">
                @foreach (var photo in servicerecord.Photos)
                {
                    <div class="col-md-3 mb-3">
                        <img src="@photo.FilePath"
                             class="img-fluid rounded"
                             alt="@photo.Caption" />

                        @if (!string.IsNullOrWhiteSpace(photo.Caption))
                        {
                            <div>@photo.Caption</div>
                        }
                    </div>
                }
            </div>
        }

        @if (!string.IsNullOrEmpty(uploadError))
        {
            <div class="alert alert-danger">
                @uploadError
            </div>
        }
        <div>
            <a href="@($"/servicerecords/edit?id={servicerecord.Id}")">Zmień</a> |
            <a href="@($"/servicerecords")">Powrót do listy</a>
        </div>
    }
</div>

@code {
    private ServiceRecord? servicerecord;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        servicerecord = await context.ServiceRecords
            
            .Include(sr => sr.Asset)
            .ThenInclude(a => a.Site)
            .ThenInclude(s => s.Customer)
            .Include(sr => sr.Photos)
            .FirstOrDefaultAsync(m => m.Id == Id); 

        if (servicerecord is null)
        {
            NavigationManager.NotFound();
        }
    }

    private string? uploadError;

    private async Task UploadPhoto(InputFileChangeEventArgs e)
    {
        uploadError = null;

        var file = e.File;

        const long maxFileSize = 15 * 1024 * 1024;

        if (file.Size > maxFileSize)
        {
            uploadError = "Zdjęcie jest za duże. Maksymalny rozmiar to 15MB.";
            return;
        }

        try
        {
            await using var stream =
                file.OpenReadStream(maxFileSize);

            var relativeDirectory = Path.Combine(
                "uploads",
                DateTime.Now.Year.ToString(),
                DateTime.Now.Month.ToString("00"));

            var result = await ImageService.SaveImageAsync(
                stream,
                file.Name,
                relativeDirectory);

            var photo = new Photo
            {
                // Original filename supplied by the user/device
                FileName = file.Name,

                // Generated physical/web filename
                FilePath = result.FilePath,

                UploadedAt = DateTime.Now,

                ServiceRecordId = servicerecord.Id
            };

            using var db = DbFactory.CreateDbContext();

            db.Photos.Add(photo);
            await db.SaveChangesAsync();

            servicerecord.Photos.Add(photo);
        }
        catch (Exception ex)
        {
            uploadError = $"Photo upload failed: {ex.Message}";
        }
    }
}
