@page "/servicerecords"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Groundskeeper.Models
@using Groundskeeper.Data
@implements IAsyncDisposable
@inject IDbContextFactory<Groundskeeper.Data.GroundskeeperDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Kartoteka zabiegów</PageTitle>

<h1>Karoteka zabiegów</h1>

<p>
    <a href="servicerecords/create">Dodaj zabieg</a>
</p>

<QuickGrid Class="table" Items="ServiceRecords.AsQueryable()">
    
    <TemplateColumn Title="Boisko">
        @($"{context.Asset.Site.Customer.Name}\\{context.Asset.Site.Name}\\{context.Asset.Name}")
    </TemplateColumn>
    <PropertyColumn Property="servicerecord => servicerecord.ServiceDate" Format="d" Title="Data"/>
    <PropertyColumn Property="servicerecord => servicerecord.Title" Title="Nazwa"/>
    <PropertyColumn Property="servicerecord => servicerecord.Description" Title="Opis wew."/>
    <PropertyColumn Property="servicerecord => servicerecord.Notes" Title="Opis zew."/>

    <TemplateColumn Context="servicerecord">
        <a href="@($"servicerecords/edit?id={servicerecord.Id}")">Zmień</a> |
        <a href="@($"servicerecords/details?id={servicerecord.Id}")">Szczegóły</a> |
        <a href="@($"servicerecords/delete?id={servicerecord.Id}")">Usuń</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private GroundskeeperDbContext context = default!;

    List<ServiceRecord> ServiceRecords = [];

    protected override async Task OnInitializedAsync()
    {
        context = DbFactory.CreateDbContext();

        ServiceRecords = await context.ServiceRecords
             .Include(sr => sr.Asset)
                .ThenInclude(a => a.Site)
                .ThenInclude(s => s.Customer)
            .ToListAsync();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
