@page "/sites/create"
@using Microsoft.EntityFrameworkCore
@using Groundskeeper.Models
@inject IDbContextFactory<Groundskeeper.Data.GroundskeeperDbContext> DbFactory
@inject NavigationManager NavigationManager

@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]


<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>Site</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Site" OnValidSubmit="AddSite" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>
            <div class="mb-3">
                <label for="name" class="form-label">Nazwa obiektu:</label> 
                <InputText id="name" @bind-Value="Site.Name" class="form-control" /> 
                <ValidationMessage For="() => Site.Name" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="address" class="form-label">Adres:</label> 
                <InputText id="address" @bind-Value="Site.Address" class="form-control" /> 
                <ValidationMessage For="() => Site.Address" class="text-danger" /> 
            </div>        
                
            <div class="mb-3">
                <label for="customer" class="form-label">Klient:</label> 
                
                <InputSelect id="customer"
                             @bind-Value="Site.CustomerId"
                             class="form-control">
                    <option value="">-- Wybierz klienta --</option>

                    @foreach (var customer in Customers)
                    {
                        <option value="@customer.Id">@customer.Name</option>
                    }
                </InputSelect>

                <ValidationMessage For="() => Site.CustomerId"
                                   class="text-danger" />

            </div>        
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/sites">Powrót do listy</a>
</div>

@code {
    [SupplyParameterFromForm]
    private Site Site { get; set; } = default!;

    private List<Customer> Customers = [];

    protected override void OnInitialized() => Site ??= new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddSite()
    {
        using var context = DbFactory.CreateDbContext();
        context.Sites.Add(Site);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/sites");
    }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();

        Customers = await context.Customers
            .OrderBy(c => c.Name)
            .ToListAsync();
    }
}
