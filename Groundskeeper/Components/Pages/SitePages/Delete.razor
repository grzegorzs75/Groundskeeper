@page "/sites/delete"
@using Microsoft.EntityFrameworkCore
@using Groundskeeper.Models
@inject IDbContextFactory<Groundskeeper.Data.GroundskeeperDbContext> DbFactory
@inject NavigationManager NavigationManager

@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]


<PageTitle>Usuń obiekt</PageTitle>

<h1>Usuń</h1>

<p>Czy na pewno chcesz usunąć ten obiekt?</p>
<div>
    <h2>Obiekt</h2>
    <hr />
    @if (site is null)
    {
        <p><em>Pobieranie...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Nazwa obiektu</dt>
            <dd class="col-sm-10">@site.Name</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Adres</dt>
            <dd class="col-sm-10">@site.Address</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Id klienta</dt>
            <dd class="col-sm-10">@site.CustomerId</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Nazwa klienta</dt>
            <dd class="col-sm-10">@site.Customer.Name</dd>
        </dl>
        <EditForm method="post" Model="site" OnValidSubmit="DeleteSite" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(site is null)">Usuń</button> |
            <a href="/sites">Powrót do listy</a>
        </EditForm>
    }
</div>

@code {
    private Site? site;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        site = await context.Sites
            .Include(s => s.Customer)
            .FirstOrDefaultAsync(m => m.Id == Id);

        if (site is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteSite()
    {
        using var context = DbFactory.CreateDbContext();
        context.Sites.Remove(site!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/sites");
    }
}
