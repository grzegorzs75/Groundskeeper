@page "/sites/delete"
@using Microsoft.EntityFrameworkCore
@using Groundskeeper.Models
@inject IDbContextFactory<Groundskeeper.Data.GroundskeeperDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Site</h2>
    <hr />
    @if (site is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@site.Name</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Address</dt>
            <dd class="col-sm-10">@site.Address</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">CustomerId</dt>
            <dd class="col-sm-10">@site.CustomerId</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Customer</dt>
            <dd class="col-sm-10">@site.Customer</dd>
        </dl>
        <EditForm method="post" Model="site" OnValidSubmit="DeleteSite" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(site is null)">Delete</button> |
            <a href="/sites">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Site? site;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        site = await context.Sites.FirstOrDefaultAsync(m => m.Id == Id);

        if (site is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteSite()
    {
        using var context = DbFactory.CreateDbContext();
        context.Sites.Remove(site!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/sites");
    }
}
