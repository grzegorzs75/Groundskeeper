@page "/sites/details"
@using Microsoft.EntityFrameworkCore
@using Groundskeeper.Models
@inject IDbContextFactory<Groundskeeper.Data.GroundskeeperDbContext> DbFactory
@inject NavigationManager NavigationManager

@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]


<PageTitle>Szczegóły obiektu</PageTitle>

<h1>Szczxegóły</h1>

<div>
    <h2>Obiekt</h2>
    <hr />
    @if (site is null)
    {
        <p><em>Pobieranie...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Nazwa obiektu</dt>
            <dd class="col-sm-10">@site.Name</dd>
            <dt class="col-sm-2">Adres</dt>
            <dd class="col-sm-10">@site.Address</dd>
            <dt class="col-sm-2">Id klienta</dt>
            <dd class="col-sm-10">@site.CustomerId</dd>
            <dt class="col-sm-2">Nazwa klienta</dt>
            <dd class="col-sm-10">@site.Customer.Name</dd>
        </dl>
        <div>
            <a href="@($"/sites/edit?id={site.Id}")">Zmień</a> |
            <a href="@($"/sites")">Powrót do listy</a>
        </div>
    }
</div>

@code {
    private Site? site;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        site = await context.Sites
            .Include(s => s.Customer)
            .FirstOrDefaultAsync(m => m.Id == Id);

        if (site is null)
        {
            NavigationManager.NotFound();
        }
    }
}
