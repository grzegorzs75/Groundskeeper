@page "/sites/details"
@using Microsoft.EntityFrameworkCore
@using Groundskeeper.Models
@inject IDbContextFactory<Groundskeeper.Data.GroundskeeperDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<div>
    <h2>Site</h2>
    <hr />
    @if (site is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@site.Name</dd>
            <dt class="col-sm-2">Address</dt>
            <dd class="col-sm-10">@site.Address</dd>
            <dt class="col-sm-2">CustomerId</dt>
            <dd class="col-sm-10">@site.CustomerId</dd>
            <dt class="col-sm-2">Customer</dt>
            <dd class="col-sm-10">@site.Customer</dd>
        </dl>
        <div>
            <a href="@($"/sites/edit?id={site.Id}")">Edit</a> |
            <a href="@($"/sites")">Back to List</a>
        </div>
    }
</div>

@code {
    private Site? site;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        site = await context.Sites.FirstOrDefaultAsync(m => m.Id == Id);

        if (site is null)
        {
            NavigationManager.NotFound();
        }
    }
}
