@page "/sites"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Groundskeeper.Models
@using Groundskeeper.Data
@implements IAsyncDisposable
@inject IDbContextFactory<Groundskeeper.Data.GroundskeeperDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Index</PageTitle>

<h1>Index</h1>

<p>
    <a href="sites/create">Create New</a>
</p>

<QuickGrid Class="table" Items="Sites.AsQueryable()">
    <PropertyColumn Property="site => site.Name" />
    <PropertyColumn Property="site => site.Address" />
    <PropertyColumn Property="site => site.CustomerId" />
    <PropertyColumn Property="site => site.Customer.Name" />

    <TemplateColumn Context="site">
        <a href="@($"sites/edit?id={site.Id}")">Edit</a> |
        <a href="@($"sites/details?id={site.Id}")">Details</a> |
        <a href="@($"sites/delete?id={site.Id}")">Delete</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private GroundskeeperDbContext context = default!;

    List<Site> Sites = [];

    protected override async Task OnInitializedAsync()
    {
        context = DbFactory.CreateDbContext();

        Sites = await context.Sites
            .Include(s => s.Customer)
            .ToListAsync();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
