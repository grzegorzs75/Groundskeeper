@page "/sites"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Groundskeeper.Models
@using Groundskeeper.Data
@implements IAsyncDisposable
@inject IDbContextFactory<Groundskeeper.Data.GroundskeeperDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Obiekty</PageTitle>

<h1>Obiekty</h1>

<p>
    <a href="sites/create">Nowy obiekt</a>
</p>

<QuickGrid Class="table" Items="Sites.AsQueryable()">
    <PropertyColumn Property="site => site.Name" Title="Nazwa obiektu" />
    <PropertyColumn Property="site => site.Address" Title="Adres" />
    <PropertyColumn Property="site => site.Customer.Name" Title="Nazwa klienta" />

    <TemplateColumn Context="site">
        <a href="@($"sites/edit?id={site.Id}")">Zmień</a> |
        <a href="@($"sites/details?id={site.Id}")">Szczegóły</a> |
        <a href="@($"sites/delete?id={site.Id}")">Usuń</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private GroundskeeperDbContext context = default!;

    List<Site> Sites = [];

    protected override async Task OnInitializedAsync()
    {
        context = DbFactory.CreateDbContext();

        Sites = await context.Sites
            .Include(s => s.Customer)
            .ToListAsync();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
